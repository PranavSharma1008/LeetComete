{
  "name": "leetcomete",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first, intelligent autocomplete for browser-based code editors.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test && npm run build",
    "icons": "node scripts/generate-icons.mjs",
    "version:sync": "node scripts/version.mjs",
    "preflight": "node scripts/preflight.mjs",
    "package": "npm run check && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
